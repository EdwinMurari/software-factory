#!/usr/bin/env bash
set -euo pipefail
export PATH="/home/berry/.nvm/versions/node/v26.5.0/bin:/home/berry/.local/bin:/usr/local/bin:/usr/bin:/bin"
# Resolve the installed symlink once. Children keep this release for the whole run.
release_dir=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
exec /home/berry/.nvm/versions/node/v26.5.0/bin/node \
  --import "$release_dir/node_modules/tsx/dist/loader.mjs" \
  "$release_dir/src/cli.ts" "$@"
