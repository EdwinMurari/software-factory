[Unit]
Description=Berry AFK software factory
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/appdata/berry/projects/services/software-factory/afk
Environment=HOME=/home/berry
Environment=GIT_CONFIG_GLOBAL=/srv/appdata/berry/state/services/software-factory/gitconfig
Environment=PATH=/home/berry/.nvm/versions/node/v26.5.0/bin:/home/berry/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=BERRY_AFK_CONFIG=/srv/appdata/berry/config/software-factory/repositories.json
EnvironmentFile=-/srv/appdata/berry/config/software-factory/service.env
ExecStart=/home/berry/.nvm/versions/node/v26.5.0/bin/node --import /srv/appdata/berry/state/services/software-factory/runtime/node_modules/tsx/dist/loader.mjs /srv/appdata/berry/projects/services/software-factory/afk/src/service.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
